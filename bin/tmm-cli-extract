#!/usr/bin/env python3
"""Pull the assistant's answer text out of an opencode `run --format json`
stream (JSONL). opencode wraps its reply in step/tool events and a status
header; the actual answer lives in `type:"text"` events (`part.text`). We
concatenate those in order so a streamed or multi-part answer comes out whole,
and print nothing if there was no text (the caller treats empty as an error)."""
import sys, json

out = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        ev = json.loads(line)
    except Exception:
        continue
    if not isinstance(ev, dict) or ev.get("type") != "text":
        continue
    part = ev.get("part")
    text = part.get("text") if isinstance(part, dict) else ev.get("text")
    if isinstance(text, str):
        out.append(text)

sys.stdout.write("".join(out))
