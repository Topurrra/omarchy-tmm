#!/usr/bin/env python3
"""Add or remove the Missing Manual entries in Omarchy's user menu file.

Omarchy reads exactly one user menu extension file:

    ~/.config/omarchy/extensions/omarchy-menu.jsonc

It is shared by everything you add to the menu, so copying a fragment over it
destroys whatever else was there. This merges our entries in instead, and can
take them back out again - which deleting the plugin cannot do, since the menu
entry does not live in the plugin directory.

Usage:
    tmm-menu install [--fragment PATH]   add or refresh the Missing Manual entries
    tmm-menu remove                      take them out again
    tmm-menu status                      show what is currently in the file

Only whole members whose key is ours are touched, so other plugins' entries and
their comments survive byte for byte. The result is parsed before it is saved,
and the previous version is kept as <file>.bak.
"""

import argparse
import json
import os
import re
import shutil
import sys

MENU_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "omarchy", "extensions", "omarchy-menu.jsonc",
)
# Our keys: "tmm" and anything under it. Covers the older "tmm.guides" /
# "tmm.cheat" names too, so an upgrade clears them out.
OURS_KEY = re.compile(r"^tmm(\.[A-Za-z0-9_-]+)?$")


def strip_jsonc(raw):
    """Drop // and /* */ comments and trailing commas so json can parse it."""
    out, in_string, escaped = [], False, False
    i = 0
    while i < len(raw):
        ch = raw[i]
        if in_string:
            out.append(ch)
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            out.append(ch)
            i += 1
            continue
        if raw.startswith("//", i):
            while i < len(raw) and raw[i] != "\n":
                i += 1
            continue
        if raw.startswith("/*", i):
            end = raw.find("*/", i + 2)
            i = len(raw) if end == -1 else end + 2
            continue
        out.append(ch)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def parse(raw):
    return json.loads(strip_jsonc(raw))


def read_menu():
    if not os.path.exists(MENU_PATH):
        return "{\n}\n"
    with open(MENU_PATH, encoding="utf-8") as fh:
        return fh.read()


# --- brace-aware editing --------------------------------------------------
#
# Menu entries are normally multi-line objects, so matching keys with a line
# regex only ever deletes an entry's first line and orphans its body. These
# walk the real structure and cut whole members instead.

def _skip_ws(text, i):
    n = len(text)
    while i < n:
        if text[i] in " \t\r\n":
            i += 1
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            i = n if end == -1 else end + 2
        else:
            break
    return i


def _read_string(text, i):
    """`i` is the opening quote. Returns (value, index past the closing quote)."""
    n, out = len(text), []
    i += 1
    while i < n:
        c = text[i]
        if c == "\\":
            out.append(text[i:i + 2])
            i += 2
            continue
        if c == '"':
            return "".join(out), i + 1
        out.append(c)
        i += 1
    raise ValueError("unterminated string")


def _skip_value(text, i):
    """Skip one value, honouring nesting, strings and comments."""
    n = len(text)
    i = _skip_ws(text, i)
    if i >= n:
        return i
    if text[i] == '"':
        return _read_string(text, i)[1]
    if text[i] in "{[":
        depth = 0
        while i < n:
            c = text[i]
            if c == '"':
                i = _read_string(text, i)[1]
                continue
            if text.startswith("//", i) or text.startswith("/*", i):
                i = _skip_ws(text, i)
                continue
            if c in "{[":
                depth += 1
            elif c in "}]":
                depth -= 1
                if depth == 0:
                    return i + 1
            i += 1
        raise ValueError("unbalanced braces")
    while i < n and text[i] not in ",}\n":
        i += 1
    return i


def members(text):
    """Top-level members as (key, start, end); end covers a trailing comma."""
    n = len(text)
    i = text.find("{")
    if i == -1:
        raise ValueError("no opening brace")
    i += 1
    found = []
    while i < n:
        i = _skip_ws(text, i)
        if i >= n or text[i] == "}":
            break
        if text[i] != '"':
            i += 1
            continue
        start = i
        key, i = _read_string(text, i)
        i = _skip_ws(text, i)
        if i < n and text[i] == ":":
            i += 1
        i = _skip_value(text, i)
        j = _skip_ws(text, i)
        if j < n and text[j] == ",":
            i = j + 1
        found.append((key, start, i))
    return found


def fragment_lines(path):
    """Our entries from the repo fragment, as verbatim source text."""
    with open(path, encoding="utf-8") as fh:
        raw = fh.read()
    parse(raw)  # fail early if the fragment itself is broken
    return [raw[s:e].strip().rstrip(",")
            for key, s, e in members(raw) if OURS_KEY.match(key)]


def drop_ours(text):
    """Remove whole members whose key is ours, wherever they sit."""
    spans = [m for m in members(text) if OURS_KEY.match(m[0])]
    for _key, start, end in sorted(spans, key=lambda m: -m[1]):
        text = text[:start] + text[end:]
    return text


def tidy(text):
    """Collapse the blank run a deletion leaves, and any dangling comma."""
    text = re.sub(r"\n[ \t]*\n[ \t]*\n+", "\n\n", text)
    close = text.rstrip().rfind("}")
    if close == -1:
        return text
    return re.sub(r",(\s*)$", r"\1", text[:close]) + text[close:]


def _indent(member):
    """Two-space indent for a member, which may itself span lines."""
    return "\n".join("  " + ln.strip() if ln.strip() else ""
                     for ln in member.split("\n"))


def splice(text, block):
    """Insert `block` (whole members) just before the closing brace."""
    text = tidy(text)
    if not block:
        return text
    close = text.rstrip().rfind("}")
    if close == -1:
        raise SystemExit("tmm-menu: %s has no closing brace; not touching it" % MENU_PATH)
    head, tail = text[:close].rstrip(), text[close:]
    if members(text):
        head = head.rstrip().rstrip(",") + ","
    return head + "\n" + ",\n".join(_indent(m) for m in block) + "\n" + tail.lstrip()


def save(text, quiet=False):
    parsed = parse(text)  # never write something Omarchy cannot read
    os.makedirs(os.path.dirname(MENU_PATH), exist_ok=True)
    if os.path.exists(MENU_PATH):
        shutil.copy2(MENU_PATH, MENU_PATH + ".bak")
    with open(MENU_PATH, "w", encoding="utf-8") as fh:
        fh.write(text if text.endswith("\n") else text + "\n")
    if not quiet:
        ours = [k for k in parsed if OURS_KEY.match(k)]
        others = [k for k in parsed if not OURS_KEY.match(k)]
        print("wrote %s" % MENU_PATH)
        print("  ours:  %s" % (", ".join(ours) or "none"))
        print("  other: %s" % (", ".join(others) or "none"))
        print("Run: omarchy menu refresh")


def main():
    ap = argparse.ArgumentParser(prog="tmm-menu", add_help=True)
    ap.add_argument("action", choices=["install", "remove", "status"])
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    ap.add_argument("--fragment",
                    default=os.path.join(here, "extensions", "omarchy-menu.jsonc"))
    args = ap.parse_args()

    current = read_menu()

    if args.action == "status":
        if not os.path.exists(MENU_PATH):
            print("no user menu file at %s" % MENU_PATH)
            return
        try:
            keys = list(parse(current))
        except ValueError as exc:
            raise SystemExit("tmm-menu: %s is not valid JSONC: %s" % (MENU_PATH, exc))
        print(MENU_PATH)
        for key in keys:
            print("  %-16s %s" % (key, "(ours)" if OURS_KEY.match(key) else ""))
        return

    try:
        parse(current)
    except ValueError as exc:
        raise SystemExit("tmm-menu: %s is not valid JSONC, fix it first: %s" % (MENU_PATH, exc))

    if args.action == "remove":
        save(tidy(drop_ours(current)))
        return

    if not os.path.exists(args.fragment):
        raise SystemExit("tmm-menu: fragment not found: %s" % args.fragment)
    save(splice(drop_ours(current), fragment_lines(args.fragment)))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
