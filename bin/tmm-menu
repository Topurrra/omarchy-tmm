#!/usr/bin/env python3
"""Add or remove the Missing Manual entries in Omarchy's user menu file.

Omarchy reads exactly one user menu extension file:

    ~/.config/omarchy/extensions/omarchy-menu.jsonc

It is shared by everything you add to the menu, so copying a fragment over it
destroys whatever else was there. This merges our entries in instead, and can
take them back out again — which plain `rm` of the plugin cannot do, since the
menu entry does not live in the plugin directory.

Usage:
    tmm-menu install [--fragment PATH]   add/refresh the Missing Manual entries
    tmm-menu remove                      take them out again
    tmm-menu status                      show what is currently in the file

The file keeps its comments and formatting: only lines holding our own keys are
touched. The result is parsed before it is saved, and the previous version is
kept as <file>.bak.
"""

import argparse
import json
import os
import re
import shutil
import sys

MENU_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "omarchy", "extensions", "omarchy-menu.jsonc",
)
# Our keys: "tmm" and anything under it ("tmm.search", "tmm.catalog", ...).
OURS = re.compile(r'^\s*"tmm(\.[A-Za-z0-9_-]+)?"\s*:')


def strip_jsonc(raw):
    """Drop // comments and trailing commas so json can parse the result."""
    out, in_string, escaped = [], False, False
    i = 0
    while i < len(raw):
        ch = raw[i]
        if in_string:
            out.append(ch)
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            out.append(ch)
            i += 1
            continue
        if raw.startswith("//", i):
            while i < len(raw) and raw[i] != "\n":
                i += 1
            continue
        if raw.startswith("/*", i):
            end = raw.find("*/", i + 2)
            i = len(raw) if end == -1 else end + 2
            continue
        out.append(ch)
        i += 1
    text = "".join(out)
    return re.sub(r",(\s*[}\]])", r"\1", text)


def parse(raw):
    return json.loads(strip_jsonc(raw))


def read_menu():
    if not os.path.exists(MENU_PATH):
        return "{\n}\n"
    with open(MENU_PATH, encoding="utf-8") as fh:
        return fh.read()


def fragment_lines(path):
    """Our entries from the repo fragment, as verbatim source lines."""
    with open(path, encoding="utf-8") as fh:
        raw = fh.read()
    parse(raw)  # fail early if the fragment itself is broken
    return [ln.rstrip() for ln in raw.split("\n") if OURS.match(ln)]


def without_ours(text):
    kept = [ln for ln in text.split("\n") if not OURS.match(ln)]
    return "\n".join(kept)


def splice(text, lines):
    """Insert `lines` just before the closing brace, fixing up commas."""
    idx = text.rstrip().rfind("}")
    if idx == -1:
        raise SystemExit("tmm-menu: %s has no closing brace; not touching it" % MENU_PATH)
    head, tail = text[:idx].rstrip(), text[idx:]

    body = head[1:].strip() if head.startswith("{") else head.strip()
    block = "\n".join(lines).rstrip().rstrip(",")
    if body:
        body = body.rstrip().rstrip(",") + ",\n" + block
    else:
        body = block
    indented = "\n".join("  " + ln.strip() if ln.strip() else "" for ln in body.split("\n"))
    return "{\n" + indented + "\n" + tail.lstrip()


def save(text, quiet=False):
    parsed = parse(text)  # never write something Omarchy cannot read
    os.makedirs(os.path.dirname(MENU_PATH), exist_ok=True)
    if os.path.exists(MENU_PATH):
        shutil.copy2(MENU_PATH, MENU_PATH + ".bak")
    with open(MENU_PATH, "w", encoding="utf-8") as fh:
        fh.write(text if text.endswith("\n") else text + "\n")
    if not quiet:
        others = [k for k in parsed if not k.startswith("tmm")]
        print("wrote %s" % MENU_PATH)
        print("  ours:  %s" % (", ".join(k for k in parsed if k.startswith("tmm")) or "none"))
        print("  other: %s" % (", ".join(others) or "none"))
        print("Run: omarchy menu refresh")


def main():
    ap = argparse.ArgumentParser(prog="tmm-menu", add_help=True)
    ap.add_argument("action", choices=["install", "remove", "status"])
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    ap.add_argument("--fragment", default=os.path.join(here, "extensions", "omarchy-menu.jsonc"))
    args = ap.parse_args()

    current = read_menu()

    if args.action == "status":
        if not os.path.exists(MENU_PATH):
            print("no user menu file at %s" % MENU_PATH)
            return
        try:
            keys = list(parse(current))
        except ValueError as exc:
            raise SystemExit("tmm-menu: %s is not valid JSONC: %s" % (MENU_PATH, exc))
        print(MENU_PATH)
        for k in keys:
            print("  %-16s %s" % (k, "(ours)" if k.startswith("tmm") else ""))
        return

    try:
        parse(current)
    except ValueError as exc:
        raise SystemExit("tmm-menu: %s is not valid JSONC, fix it first: %s" % (MENU_PATH, exc))

    if args.action == "remove":
        save(splice(without_ours(current), []) if without_ours(current).strip() not in ("{", "{}", "{\n}")
             else "{\n}\n")
        return

    if not os.path.exists(args.fragment):
        raise SystemExit("tmm-menu: fragment not found: %s" % args.fragment)
    save(splice(without_ours(current), fragment_lines(args.fragment)))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
